[
 {
  "params": {
   "study_haze": [
    0.6, 
    0.72, 
    0.85
   ]
  }, 
  "name": "v4_water", 
  "replace": [
   [
    "EMISSION*=mix(vec3(1.13,.92,.59),", 
    "EMISSION*=mix(vec3(1.,1.,1.),"
   ], 
   [
    "ALBEDO*=mix(vec3(1.05,.91,.67),", 
    "ALBEDO*=mix(vec3(1.,1.,1.),"
   ], 
   [
    "EMISSION*vec3(.87,.94,.78)+vec3(1.1,.68,.23)*sun_reflection", 
    "EMISSION*vec3(1.,1.,1.)+vec3(.55,.52,.45)*sun_reflection"
   ], 
   [
    "vec3 dry=vec3(.73,.745,.46);", 
    "vec3 dry=vec3(.62,.72,.36);"
   ], 
   [
    "vec3 meadow=vec3(.46,.565,.345);", 
    "vec3 meadow=vec3(.40,.58,.27);"
   ], 
   [
    "pigment*=.89+.11*max(0.,dot(n,normalize(vec3(-.48,.82,.30))));", 
    "pigment*=0.80+0.20*max(0.,dot(n,normalize(vec3(-.48,.82,.30))));"
   ], 
   [
    "vec3 deep=mix(vec3(.170,.418,.627),vec3(.230,.498,.677),ripple*.16+.4);", 
    "vec3 deep=mix(vec3(.150,.380,.610),vec3(.210,.470,.665),ripple*.16+.4);"
   ], 
   [
    "vec3 c=mix(vec3(.32,.59,.65),deep,smoothstep(0.,6.,water_depth));", 
    "float shelf=smoothstep(0.,14.0,water_depth);\n    vec3 c=mix(vec3(.46,.74,.76),vec3(.30,.60,.72),smoothstep(0.,.45,shelf));\n    c=mix(c,deep,smoothstep(.35,1.,shelf));"
   ], 
   [
    "float foam=(1.-smoothstep(.05,.45,water_depth))*(.45+.15*sin(world_point.x*.2+world_point.z*.3+world_time));", 
    "float foam_px=2.*fwidth(water_depth);\n    float foam=(1.-smoothstep(0.,max(1.50,foam_px),water_depth))*(.80+.15*sin(world_point.x*.2+world_point.z*.3+world_time));"
   ], 
   [
    "EMISSION=mix(clear_water,storm_water,storm);", 
    "EMISSION=mix(clear_water,storm_water,storm);\n    EMISSION=mix(EMISSION,vec3(.88,.92,.93),foam*(1.-storm)*(1.-study_night));"
   ]
  ]
 }, 
