, 0, 0.05601098, 340.125, 0.17765869, 0, -0.6874135, 118.51489, 0, 0.71, 0, 32.72876, 0.6874135, 0, 0.17765869, 518.69507, -0.51020557, 0, 0.21330549, 43.968018, 0, 0.553, 0, 24.753109, -0.21330549, 0, -0.51020557, 43.773926, -0.01785068, 0, 0.51268935, 81.39502, 0, 0.513, 0, 31.164743, -0.51268935, 0, -0.01785068, 76.60596, 0.11684507, 0, 0.54767436, 104.79199, 0, 0.56, 0, 36.555176, -0.54767436, 0, 0.11684507, 509.375, -0.059903767, 0, 0.5145246, 266.40698, 0, 0.518, 0, 23.535713, -0.5145246, 0, -0.059903767, 38.385986)

