buffer = PackedFloat32Array(0.75394464, 0, 0.17057689, 5.6000977, 0, 0.773, 0, 105.80292, -0.17057689, 0, 0.75394464, 236.80493, -0.6970054, 0, -0.31529117, 373.359, 0, 0.765, 0, 96.38034, 0.31529117, 0, -0.6970054, 161.96411, 0.12238915, 0, 0.7915945, 0.87890625, 0, 0.801, 0, 44.748848, -0.7915945, 0, 0.12238915, 524.8191, -0.37744603, 0, 0.68373644, 21.795898, 0, 0.781, 0, 61.569458, -0.68373644, 0, -0.37744603, 177.83911, -0.66904885, 0, -0.5128573, 331.14294, 0, 0.843, 0, 57.341873, 0.5128573, 0, -0.66904885, 127.423096, 0.11008906, 0, 0.6274149, 5.6730957, 0, 0.637, 0, 51.893486, -0.6274149, 0, 0.11008906, 494.542, 0.32499382, 0, -0.6447193, 156.29297, 0, 0.722, 0, 67.98103, 0.6447193, 0, 0.32499382, 143.39209, -0.56099325, 0, -0.0027530722, 319.77197, 0, 0.561, 0, 23.332987, 0.0027530722, 0, -0.56099325, 30.75, -0.3188817, 0, -0.70086694, 208.19897, 0, 0.77, 0, 72.53262, 0.70086694, 0, -0.3188817, 145.98901, 0.6059956, 0, 0.39980662, 85.593994, 0, 0.726, 0, 99.9538, -0.39980662, 0, 0.6059956, 241.00708, -0.69635296, 0, -0.3751981, 101.16406, 0, 0.791, 0, 86.419556, 0.3751981, 0, -0.69635296, 371.35205, 0.05846375, 0, 0.43206248, 87.70508, 0, 0.436, 0, 75.50488, -0.43206248, 0, 0.05846375, 400.60498, 0.04695014, 0, 0.5871258, 302.636, 0, 0.589, 0, 34.0885, -0.5871258, 0, 0.04695014, 93.4209, 0.78119886, 0, 0.242595, 75.95703, 0, 0.818, 0, 63.716064, -0.242595, 0, 0.78119886, 163.79004, -0.51898754, 0, 0.40286592, 400.00903, 0, 0.657, 0, 72.60904, -0.40286592, 0, -0.51898754, 131.70288, -0.466907, 0, -0.31459004, 326.43396, 0, 0.563, 0, 98.60785, 0.31459004, 0, -0.466907, 171.82202, -0.41348884, 0, -0.49502724, 5.7890625, 0, 0.645, 0, 48.23987, 0.49502724, 0, -0.41348884, 162.29199, 0.45821837, 0, -0.32711613, 364.80103, 0, 0.563, 0, 66.334045, 0.32711613, 0, 0.45821837, 133.80591, -0.09885169, 0, -0.5359602, 73.12988, 0, 0.545, 0, 112.36371, 0.5359602, 0, -0.09885169, 320.33594, 0.36739358, 0, -0.5828748, 139.46606, 0, 0.689, 0, 20.894283, 0.5828748, 0, 0.36739