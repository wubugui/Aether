+    q=[0.,0.,0.];previous=triangle[-1]
+    for current in triangle:
+        for axis in range(3):
+            j=(axis+1)%3;k=(axis+2)%3
+            q[axis]=f32(q[axis]+f32(f32(previous[j]-current[j])*f32(previous[k]+current[k])))
